/* 全站基础样式。页面各自的样式写在页面目录里，不改这个文件以外的全局文件。 */
page {
  background: #f4f6fa;
  color: #1f2a37;
  font-size: 28rpx;
  line-height: 1.6;
}

.page { padding: 24rpx; }

.hero {
  padding: 32rpx 28rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #1e6fd9, #3f9bf0);
  color: #ffffff;
  margin-bottom: 24rpx;
}
.hero__title { font-size: 40rpx; font-weight: 600; }
.hero__sub { margin-top: 8rpx; font-size: 26rpx; opacity: 0.9; }

.card {
  padding: 28rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(31, 42, 55, 0.06);
}
.card__head { display: flex; justify-content: space-between; align-items: center; }
.card__title { font-size: 32rpx; font-weight: 600; }
.card__status {
  padding: 4rpx 16rpx; border-radius: 20rpx;
  font-size: 22rpx; color: #1e6fd9; background: #e8f1fd;
}
.card__row { margin-top: 10rpx; font-size: 26rpx; color: #5b6779; }
.card__hint { margin-top: 16rpx; font-size: 24rpx; color: #b06a00; }

.btn {
  margin-top: 20rpx; height: 84rpx; line-height: 84rpx;
  border-radius: 12rpx; font-size: 30rpx;
}
.btn--primary { background: #1e6fd9; color: #ffffff; }
.btn--ghost { background: #ffffff; color: #1e6fd9; border: 2rpx solid #cfe0f6; }
.btn--small { height: 68rpx; line-height: 68rpx; font-size: 26rpx; }
.btn[disabled] { opacity: 0.5; }

.actions { display: flex; gap: 20rpx; margin-bottom: 24rpx; }
.actions .btn { flex: 1; margin-top: 0; }

.field { margin-bottom: 24rpx; }
.field__label { font-size: 26rpx; color: #5b6779; }
.field__value { font-size: 30rpx; color: #1f2a37; }

.disclaimer {
  margin: 32rpx 0 16rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #eef2f8;
  font-size: 24rpx;
  color: #6b7788;
}

.empty-tip { padding: 24rpx; text-align: center; font-size: 26rpx; color: #8a94a6; }
