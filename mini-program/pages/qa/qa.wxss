.search { display: flex; align-items: center; margin-bottom: 16rpx; }
.search__input {
  flex: 1; height: 80rpx; padding: 0 20rpx;
  border-radius: 12rpx; background: #ffffff; font-size: 28rpx;
}
.search__btn {
  margin-left: 16rpx; padding: 0 28rpx; height: 80rpx; line-height: 80rpx;
  border-radius: 12rpx; background: #1e6fd9; color: #ffffff; font-size: 28rpx;
}
.presets { display: flex; flex-wrap: wrap; margin-bottom: 16rpx; }
.presets__item {
  margin: 0 16rpx 16rpx 0; padding: 10rpx 24rpx; border-radius: 30rpx;
  background: #ffffff; font-size: 24rpx; color: #1e6fd9;
}
.answer { margin-top: 12rpx; font-size: 28rpx; color: #33415c; }
.source { margin-top: 16rpx; font-size: 24rpx; color: #6b7788; }
.source--warn { color: #b06a00; }
