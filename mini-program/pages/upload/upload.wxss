.preview {
  margin: 20rpx 0; padding: 16rpx; border-radius: 12rpx;
  background: #f4f6fa; text-align: center;
}
.preview--empty { padding: 60rpx 0; color: #8a94a6; font-size: 26rpx; }
.preview__img { width: 100%; height: 420rpx; border-radius: 8rpx; }
.preview__meta { margin-top: 12rpx; font-size: 24rpx; color: #6b7788; }
.tip { margin-top: 16rpx; font-size: 26rpx; color: #d0453a; }
