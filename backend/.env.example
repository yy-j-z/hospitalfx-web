# 本地 MySQL 连接
DB_URL=jdbc:mysql://127.0.0.1:3306/his?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&createDatabaseIfNotExist=true
DB_USERNAME=hospitalfx
DB_PASSWORD=

# 首次运行推荐 always，这样会自动建表并导入演示数据
SQL_INIT_MODE=always

# 本地开发允许的前端来源
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*

# 不演示 AI 时可以留空
DEEPSEEK_API_KEY=
